# Copy these settings to a protected environment file. Never commit real values.
SUNMI_DATA_DIR=/srv/sunmi_t2_mini/data
SUNMI_PUBLIC_URL=https://printer.example.com

SUNMI_ADMIN_USERNAME=admin
SUNMI_ADMIN_PASSWORD_HASH=pbkdf2_sha256$REPLACE_WITH_A_GENERATED_HASH
SUNMI_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Leave both print-account values empty to disable the restricted account.
SUNMI_PRINT_USERNAME=
SUNMI_PRINT_PASSWORD_HASH=

SUNMI_DEVICE_ID=t2-mini-01
SUNMI_DEVICE_TOKEN_HASH=REPLACE_WITH_A_GENERATED_SHA256_HASH

SUNMI_ONLINE_WINDOW_SECONDS=30
SUNMI_LEASE_SECONDS=90
SUNMI_MAX_ATTEMPTS=5
