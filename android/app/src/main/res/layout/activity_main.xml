<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_background"
        android:elevation="8dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_printer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/agent_title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/agent_subtitle"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E4F4ED"
            android:padding="16dp"
            android:text="Initialisation…"
            android:textColor="@color/green_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/restart"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:text="@string/restart_service"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/dashboard"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/open_dashboard"
                android:textAllCaps="false"
                android:textColor="@color/green_dark"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

